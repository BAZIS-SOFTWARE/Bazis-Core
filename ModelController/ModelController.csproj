<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0</TargetFrameworks>
    <Title>ModelController</Title>
    <Version>3.1.13.6</Version>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <SignAssembly>True</SignAssembly>
    <AssemblyOriginatorKeyFile>ModelControllerKey.snk</AssemblyOriginatorKeyFile>
    <Company>BAZIS SOFTWARE</Company>
    <Product>BAZIS</Product>
    <Description>Contains basic mesh oblects and geometry classes</Description>
    <Copyright>Bilenko Georgy</Copyright>
    <Authors>Bilenko Georgy, Kapkaev Victor, Kochuk Nicolay, Kishun Kirill, Aleksey Konteev</Authors>
    <PackageIcon>Icon.png</PackageIcon>
    <PackageLicenseExpression> MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="MeshObjsCreator\Delone2D\**" />
    <EmbeddedResource Remove="MeshObjsCreator\Delone2D\**" />
    <None Remove="MeshObjsCreator\Delone2D\**" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="Icon.png" />
    <None Remove="Interfaces\Icon.png" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Icon.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </EmbeddedResource>
    <EmbeddedResource Include="Interfaces\Icon.png">
      <PackagePath>\</PackagePath>
      <Pack>True</Pack>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="NetOctree" Version="2.1.11" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Model\Model.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Interfaces\GmshController\" />
  </ItemGroup>
</Project>