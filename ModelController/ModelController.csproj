<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net48</TargetFrameworks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Title>ModelController</Title>
    <Version>1.0.10.83</Version>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <SignAssembly>True</SignAssembly>
    <AssemblyOriginatorKeyFile>ModelControllerKey.snk</AssemblyOriginatorKeyFile>
    <Company>BAZIS SOFTWARE</Company>
    <Product>BAZIS</Product>
    <Description>Contains basic mesh oblects and geometry classes</Description>
    <Copyright>Bilenko Georgy</Copyright>
    <Authors>Bilenko Georgy, Kapkaev Victor, Kochuk Nicolay, Kishun Kirill</Authors>
    <PackageIcon>Icon.png</PackageIcon>
    <PackageLicenseExpression> MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="Icon.png" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="MeshObjsUtility\CrossSection.cs" />
    <Compile Include="ModelController.cs" />
    <Compile Include="ModelScenePresentator\GlObjsPresenters\LineObjsPresenter.cs" />
    <Compile Include="ModelScenePresentator\GlObjsPresenters\PointObjsPresenter.cs" />
    <Compile Include="ModelScenePresentator\GlObjsPresenters\SurfaceObjsPresenter.cs" />
    <Compile Include="ModelScenePresentator\GlObjsVertexCreators\CoordsLineObjsCreator.cs" />
    <Compile Include="ModelScenePresentator\GlObjsVertexCreators\CoordsPointObjsCreator.cs" />
    <Compile Include="ModelScenePresentator\GlObjsVertexCreators\CoordsSurfaceObjsCreator.cs" />
    <Compile Include="ModelScenePresentator\GlObjsVertexCreators\EdgesSurfaceObjsCreator.cs" />
    <Compile Include="ModelScenePresentator\Interfaces\IEdgeObjsVertexCreator.cs" />
    <Compile Include="ModelScenePresentator\Interfaces\ILineObjsVertexCreator.cs" />
    <Compile Include="ModelScenePresentator\Interfaces\IPointObjsVertexCreator.cs" />
    <Compile Include="ModelScenePresentator\Interfaces\ISurfaceObjsVertexCreator.cs" />
    <Compile Include="MeshObjsCreator\Extract2DFrom3D.cs" />
    <Compile Include="MeshObjsUtility\FindCoincidentObjects.cs" />
    <Compile Include="MeshObjsUtility\InterfacedNodesFinder.cs" />
    <Compile Include="MeshObjsUtility\FindBoundaryEdges.cs" />
    <Compile Include="MeshObjsUtility\MergeObjects.cs" />
    <Compile Include="MeshObjsUtility\NormalsCalculator.cs" />
    <Compile Include="MeshObjsUtility\FreeNodesFinder.cs" />
    <Compile Include="MeshObjsUtility\FindOpenSurfaceNodes.cs" />
    <Compile Include="MeshObjsUtility\SelectionHelper.cs" />
    <Compile Include="ModelScenePresentator\ModelScenePresentator.cs" />
    <Compile Include="ModelSceneSelector.cs" />
    <Compile Include="ModelSelectToolStripPresentator.cs" />
    <Compile Include="ModelScenePresentator\GlObjsVertexCreators\NormalsLineObjsCreator.cs" />
    <Compile Include="ModelScenePresentator\GlObjsVertexCreators\NormalsPointObjsCreator.cs" />
    <Compile Include="ModelScenePresentator\GlObjsVertexCreators\NormalsSurfaceObjsCreator.cs" />
    <Compile Include="ModelScenePresentator\GlObjsVertexCreators\ColorLineObjsCreator.cs" />
    <Compile Include="ModelScenePresentator\GlObjsVertexCreators\ColorPointObjsCreator.cs" />
    <Compile Include="ModelScenePresentator\GlObjsVertexCreators\ColorSurfaceObjsCreator.cs" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Icon.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="NetOctree" Version="2.1.10" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ModelControllerInterfaces\ModelControllerInterfaces.csproj" />
    <ProjectReference Include="..\Model\Model.csproj" />
  </ItemGroup>
</Project>