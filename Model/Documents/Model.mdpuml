@startuml
top to bottom direction
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam nodesep 18
skinparam ranksep 24
skinparam packageStyle rectangle
hide empty members
set namespaceSeparator none

allowmixing
title Model — обзор классов и расположение подробностей
caption Обзор; полный состав членов — на нумерованных поддиаграммах
interface "IModelData" as T_Model_Model_Interfaces_IModelData <<details>>
note right of T_Model_Model_Interfaces_IModelData
  [[Model-3.mdpuml Model-3]]
end note
