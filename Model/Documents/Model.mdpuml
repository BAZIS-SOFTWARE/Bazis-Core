note right of T_Model_Model_Interfaces_IObjectsData
  [[Model-14.mdpuml Model-14]], [[Model-15.mdpuml Model-15]]
end note
class "ObjectsData" as T_Model_Model_ObjectsData <<details>>
note right of T_Model_Model_ObjectsData
  [[Model-17.mdpuml Model-17]]
end note
