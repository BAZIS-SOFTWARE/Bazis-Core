T_Model_Model_ModelData ..|> T_Model_Model_Interfaces_IModelData
T_Model_Model_ObjectsCollections_ObjectsCollection_1 --> T_Model_Model_ObjectsCollections_ObjectsSet_1 : использует
T_Model_Model_ObjectsCollections_ObjectsCollection_1 ..|> T_Model_Model_Interfaces_ObjectsCollections_IObjectsCollection_1
T_Model_Model_ObjectsCollections_ObjectsSet_1 ..|> T_Model_Model_Interfaces_ObjectsCollections_IObjectsSet_1
