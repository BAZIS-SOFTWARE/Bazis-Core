note right of T_Model_Model_Interfaces_ObjectsCollections_IObjectsSet_1
  [[Model-16.mdpuml Model-16]]
end note
class "ObjectsSet<T>" as T_Model_Model_ObjectsCollections_ObjectsSet_1 <<details>>
note right of T_Model_Model_ObjectsCollections_ObjectsSet_1
  [[Model-18.mdpuml Model-18]]
end note
interface "IObjectsCollection<T>" as T_Model_Model_Interfaces_ObjectsCollections_IObjectsCollection_1 <<details>>
note right of T_Model_Model_Interfaces_ObjectsCollections_IObjectsCollection_1
  [[Model-16.mdpuml Model-16]]
end note
class "ObjectsCollection<T>" as T_Model_Model_ObjectsCollections_ObjectsCollection_1 <<details>>
note right of T_Model_Model_ObjectsCollections_ObjectsCollection_1
  [[Model-18.mdpuml Model-18]]
end note
T_Model_Model_GroupsData_GroupData ..|> T_Model_Model_Interfaces_IGroupData
T_Model_Model_Interfaces_IModelData --> T_Model_Model_Interfaces_IGroupData : использует
T_Model_Model_Interfaces_IModelData --> T_Model_Model_Interfaces_IObjectsData : использует
T_Model_Model_Interfaces_IObjectsData --> T_Model_Model_Interfaces_ObjectsCollections_IObjectsCollection_1 : использует
