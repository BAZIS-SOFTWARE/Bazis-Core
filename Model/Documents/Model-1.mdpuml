skinparam nodesep 18
skinparam ranksep 24
skinparam packageStyle rectangle
hide empty members
set namespaceSeparator none

title Model-1 — Геометрические и сеточные сущности
caption Целевой состав API; расхождения с кодом — ArchitectureDifferences.md
interface "IModelObject" as T_Model_Model_Interfaces_IModelObject {
  + Dim : int [get]
  + ExistState : bool [get, set]
  + Number : int [get]
  + ObjType : ObjType [get]
  + CalcCentr() : Point3D
  + SetNumber(number) : void
}
interface "IIntegralObject" as T_Model_Model_Interfaces_IntegralObject_IIntegralObject {
  + GetIntegralPoints() : IEnumerable<IIntegralPoint>
}
interface "IIntegralPoint" as T_Model_Model_Interfaces_IntegralObject_IIntegralPoint {
  + Index : int [get, set]
  + Jacobi : Matrix<double> [get]
  + Weigt : double [get, set]
  + this[string dirInd] : double [get]
  + AddCoordinate(name, value) : void
  + GetCoordinates() : IEnumerable<KeyValuePair<string, double>>
}
interface "IElement" as T_Model_Model_Interfaces_MeshObjects_IElement {
  + ElementKind : ElementKind [get]
  + IncidentMatrix : int[][] [get]
  + Level : int [get, set]
  + this[int nodeInd] : Node [get, set]
  + CalcJacobi(integralPoint) : Matrix<double>
  + CreateIntegrationPoints(level) : IEnumerable<IntegralPoint>
  + GetDerivativesFormFunctions(intPoint) : double[,]
  + GetFormFunctions(intPoint) : double[]
  + GetNodeIndex(node) : int
}
interface "IElement1D" as T_Model_Model_Interfaces_MeshObjects_IElement1D {
}
interface "IElement2D" as T_Model_Model_Interfaces_MeshObjects_IElement2D {
  + TransitionMatrix : Matrix<double> [get, set]
  + CalcTransitionMatrix(points) : double[,]
  + CreateIntegrationPoint(w, ksi, eta) : IntegralPoint
}
