T_Model_Model_IO_SaveModelToBPFTextFile -[hidden]down-> T_Model_Model_IO_STL_LoadFromSTLFile
T_Model_Model_IO_STL_LoadFromSTLFile -[hidden]down-> T_Model_Model_IO_STL_SaveModelToBinarySTLFile
T_Model_Model_IO_STL_SaveModelToBinarySTLFile -[hidden]down-> T_Model_Model_IO_STL_SaveToTxtSTLFile
