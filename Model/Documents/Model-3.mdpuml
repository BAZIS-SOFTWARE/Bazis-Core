@startuml
top to bottom direction
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam nodesep 18
skinparam ranksep 24
skinparam packageStyle rectangle
hide empty members
set namespaceSeparator none

title Model-3 — Модель, наборы и группы
caption Целевой состав API; расхождения с кодом — ArchitectureDifferences.md
interface "IGroup" as T_Model_Model_Interfaces_IGroup {
  + Name : string [get, set]
  + Number : int [get]
  + ObjType : ObjType [get]
  + AddRange(items) : void
  + ClearRemoved() : void
  + Reverse() : void
  + SortByDistance() : void
  + Swap(fInd, sInd) : bool
}
interface "IGroupData" as T_Model_Model_Interfaces_IGroupData {
  + ClearNotExisted() : void
  + Create(modelObjects) : string
  + Create(name, modelObjects) : void
  + Create(name, objType) : void
  + Find(index) : IGroup
  + Find(grName) : IGroup
  + FindMany(objType) : IEnumerable<IGroup>
  + GetMaxNumber() : int
  + Sort() : void
}
interface "ILineObject<T>" as T_Model_Model_Interfaces_ILineObject_1 {
  + CalcLength() : double
}
interface "IModelData" as T_Model_Model_Interfaces_IModelData {
  + GroupData : IGroupData [get]
  + Loader : IModelLoader [get, set]
  + ObjectData : IObjectsData [get]
  + Saver : IModelSaver [get, set]
  + VolumeData : VolumeData [get]
  + Append(modelData) : IReadOnlyList<string>
  + ClearAll() : void
  + Load(path) : void
  + Save(path) : void
  + SetGroupData(objectData) : void
  + SetObjectData(objectData) : void
}
interface "INormal" as T_Model_Model_Interfaces_INormal {
  + CalcNormal() : Point3D
}
interface "IModelObject\nModel-1" as T_Model_Model_Interfaces_IModelObject <<reference>> [[Model-1.mdpuml Model-1]]
interface "IVertexObject<T>\nModel-15" as T_Model_Model_Interfaces_IVertexObject_1 <<reference>> [[Model-15.mdpuml Model-15]]
