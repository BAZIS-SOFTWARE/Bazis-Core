@startuml
top to bottom direction
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam nodesep 18
skinparam ranksep 24
skinparam packageStyle rectangle
hide empty members
set namespaceSeparator none

title Model-13 — Загрузка и сохранение
caption Целевой состав API; расхождения с кодом — ArchitectureDifferences.md
class "StlFileWriteExeption" as T_Model_Model_IO_STL_StlFileWriteExeption {
  + StlFileWriteExeption(message)
  + StlFileWriteExeption(message, inner)
}
legend bottom
  Обзор: [[Model.mdpuml Model]]; сигнатуры: [[Model-13.md Model-13.md]].
  reference — адрес подробностей указан в заголовке типа.
  Параметры методов: имена; полные сигнатуры — в соседнем .md.
  Унаследованные члены интерфейсов в классах не повторяются.
endlegend
@enduml
