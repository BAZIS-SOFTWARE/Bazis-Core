<Project Sdk="Microsoft.NET.Sdk"> 
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AutoGenerateBindingRedirects>True</AutoGenerateBindingRedirects>
    <OutputType>Library</OutputType>
    <AssemblyName>Model</AssemblyName>
    <RootNamespace>Model</RootNamespace>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <SignAssembly>True</SignAssembly>
    <AssemblyOriginatorKeyFile>ModelKey.snk</AssemblyOriginatorKeyFile>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Title>Model</Title>
    <Version>2.0.9.56</Version>
    <Company>BAZIS SOFTWARE</Company>
    <Product>BAZIS</Product>
    <Description>Contains basic mesh oblects and geometry classes</Description>
    <Copyright>Bilenko Georgy</Copyright>
    <Authors>Bilenko Georgy, Kapkaev Victor, Kochuk Nicolay, Kishun Kirill</Authors>
    <PackageIcon>Icon.png</PackageIcon>
    <PackageLicenseExpression> MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
  </PropertyGroup> 
  <ItemGroup>
    <EmbeddedResource Remove="Interfaces\**" />
    <None Remove="Interfaces\**" />
  </ItemGroup> 
  <ItemGroup>
    <Compile Include="Events\LoaderEventArgs.cs" />
    <Compile Include="Events\SaverEventArgs.cs" />
    <Compile Include="GeometryObjects\Figure2D.cs" />
    <Compile Include="GeometryObjects\GeometrySurface.cs" />
    <Compile Include="MeshObjects\Hexa.cs" />
    <Compile Include="GeometryObjects\Point.cs" />
    <Compile Include="IO\LoadModelFromProjectTextFile.cs" />
    <Compile Include="IO\SaveModelToProjectTextFile.cs" />
    <Compile Include="IO\LoadModelFromASCIITextFile.cs" />
    <Compile Include="IO\LoadModelFromCDBTextFile.cs" />
    <Compile Include="IO\LoadModelFromGMSHTextFile.cs" />
    <Compile Include="IO\LoadModelFromSalomeFile.cs" />
    <Compile Include="IO\LoadModelFromSTLFile.cs" />
    <Compile Include="IO\SaveModelToASCIITextFile.cs" />
    <Compile Include="MeshObjects\Beam.cs" />
    <Compile Include="GroupsData\Group.cs" />
    <Compile Include="GroupsData\CompareGroupsByName.cs" />
    <Compile Include="GroupsData\GroupData.cs" />
    <Compile Include="MeshObjects\IntegralPoint.cs" />
    <Compile Include="ModelData.cs" />
    <Compile Include="ModelObject.cs" />
    <Compile Include="GeometryObjects\Line.cs" />
    <Compile Include="MeshObjects\Element.cs" />
    <Compile Include="MeshObjects\Element2D.cs" />
    <Compile Include="MeshObjects\Element3D.cs" />
    <Compile Include="MeshObjects\Node.cs" />
    <Compile Include="MeshObjects\Penta.cs" />
    <Compile Include="MeshObjects\Quad.cs" />
    <Compile Include="MeshObjects\SurfaceFinder.cs" />
    <Compile Include="ObjectsData.cs" />
    <Compile Include="MeshObjects\ElementSurface.cs" />
    <Compile Include="MeshObjects\Tetra.cs" />
    <Compile Include="MeshObjects\Triangle.cs" />
  </ItemGroup> 
  <ItemGroup>
    <PackageReference Include="Functions" Version="1.0.2.43" />
    <PackageReference Include="Geometry" Version="2.0.7.20" />
    <PackageReference Include="MathNet.Numerics.Signed" Version="5.0.0" />
  </ItemGroup> 
  <ItemGroup>
    <ProjectReference Include="..\ModelInterfaces\ModelInterfaces.csproj" />
  </ItemGroup> 
  <ItemGroup>
    <None Update="Icon.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>
</Project>