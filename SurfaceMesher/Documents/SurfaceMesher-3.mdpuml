@startuml
top to bottom direction
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam nodesep 18
skinparam ranksep 24
skinparam packageStyle rectangle
hide empty members
set namespaceSeparator none

title SurfaceMesher-3 — Сущности двумерной сетки
caption Целевой состав API; расхождения с кодом — ArchitectureDifferences.md
class "Quad2D" as T_SurfaceMesher_SurfaceMesher_Quad2D {
  + A : Node2D [get]
  + B : Node2D [get]
  + C : Node2D [get]
  + D : Node2D [get]
  + Index : int [get]
  + Quad2D(index, a, b, c, d)
}
class "Triangle2D" as T_SurfaceMesher_SurfaceMesher_Triangle2D {
  + A : Node2D [get]
  + B : Node2D [get]
  + C : Node2D [get]
  + Index : int [get]
  + GetArea() : double
  + GetCentroid() : Point2D
  + GetNodes() : IEnumerable<Node2D>
  + GetQuality() : double
  + ToString() : string
  + Triangle2D(index, a, b, c)
}
class "Vector" as T_SurfaceMesher_SurfaceMesher_Vector <<static>> {
  + CrossProduct(a, b) : double
  + DotProduct(a, b) : double
  + GetSquaredVectorLength(vec) : double
  + GetVectorLength(vec) : double
}
abstract class "Element" as T_SurfaceMesher_SurfaceMesher_Element <<reference>>
T_SurfaceMesher_SurfaceMesher_Quad2D -[hidden]down-> T_SurfaceMesher_SurfaceMesher_Triangle2D
T_SurfaceMesher_SurfaceMesher_Triangle2D -[hidden]down-> T_SurfaceMesher_SurfaceMesher_Vector
T_SurfaceMesher_SurfaceMesher_Vector -[hidden]down-> T_SurfaceMesher_SurfaceMesher_Element
T_SurfaceMesher_SurfaceMesher_Quad2D --|> T_SurfaceMesher_SurfaceMesher_Element
T_SurfaceMesher_SurfaceMesher_Triangle2D --|> T_SurfaceMesher_SurfaceMesher_Element
legend bottom
  reference — тип раскрыт на другой диаграмме.
  Параметры методов: имена; полные сигнатуры — в соседнем .md.
  Унаследованные члены интерфейсов в классах не повторяются.
endlegend
@enduml
