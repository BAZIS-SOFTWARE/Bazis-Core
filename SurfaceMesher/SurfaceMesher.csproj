<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>library</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Version>0.9.2</Version>
	<SignAssembly>False</SignAssembly>
	<Title>$(AssemblyName)</Title>
	<AssemblyOriginatorKeyFile>..\SurfaceMeshingKey.snk</AssemblyOriginatorKeyFile>
  <PackageOutputPath Condition="'$(OS)' == 'Windows_NT'">c:\BazisComponents\IntPackages_v2\$(Configuration)</PackageOutputPath>
  </PropertyGroup>

  <!--Копирование собранного пакета в необходимую папку-->
  <Target Name="CopyPackage" AfterTargets="Pack">
    <Copy SourceFiles="$(PackageOutputPath)\$(PackageId).$(PackageVersion).nupkg" DestinationFolder="\\fs\Plm-Ural\OrgUnits\developers\Packages\Core\$(Configuration)" />
  </Target>

  <ItemGroup>
    <Compile Remove="DeloneTriangulation.cs" />
    <Compile Remove="DeloneTriangulation_m.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NetTopologySuite" Version="2.6.0" />
  </ItemGroup>

</Project>
