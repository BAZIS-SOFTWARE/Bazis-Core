@startuml
start
while (пока стек не пуст)
	:снять с верхушки стека треугольник;
	:найти смежный с ним треугольник,
	лежащий напротив добавленной точки;
	if (треугольники нарушают условие Делоне?) then (да)
		:перебросить ребро, по которому пересекаются
		два треугольника;
		:Добавить два новых треугольника в стек, 
		если необходимо выполнить проверку 
		на условие Делоне для них;
	endif
endwhile
stop
@enduml