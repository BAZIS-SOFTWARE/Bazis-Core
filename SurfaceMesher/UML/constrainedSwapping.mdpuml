@startuml
start
while (пока очередь не пуста)
	:взять ребро e из очереди;
	:T1 и T2 - треугольники, общим ребром которых является e;
	if (T1 и Т2 образуют выпуклый четырёхугольник?)  then (да)
		:перебросить ребро e методом Swapping;
		if (после переброски ребро все ещё 
		пересекается с ограничением?) then (да)
			:добавить переброшенное ребро e в очередь;
		else (нет)
			:добавить переброшенное ребро 
			в список newEdges;
		endif
	else (нет)
		:добавить ребро e в очередь;
	endif
endwhile
stop
@enduml