title Project-4 — Проект, задача и граничные условия
caption Целевой состав API; расхождения с кодом — ArchitectureDifferences.md
interface "ICondData" as T_Project_Project_Interfaces_Tasks_ICondData {
  + Direction : Direction [get]
  + Function : Function [get, set]
  + LocalFrame : LocalFrame [get, set]
  + Value : double [get, set]
  + TrySetDirection(v) : void
  + TrySetValue(v) : void
}
interface "IData" as T_Project_Project_Interfaces_Tasks_IData {
  + Kind : DataKind [get]
}
interface "IFrameData" as T_Project_Project_Interfaces_Tasks_IFrameData {
  + FrameFunction : IFrameFunction [get]
  + LocalFrame : ILocalFrame [get, set]
}
interface "IFrameFunction" as T_Project_Project_Interfaces_Tasks_IFrameFunction {
  + CalcValue(elementCenter) : double
  + GetIntersectedObjects<T>(elements) : List<T>
  + IsOverlappingSelf(velocity) : bool
}
interface "IGroupDependent" as T_Project_Project_Interfaces_Tasks_IGroupDependent {
  + Group : IGroup [get, set]
}
interface "ILocalFrame" as T_Project_Project_Interfaces_Tasks_ILocalFrame {
  + Frame : Frame [get, set]
  + Rotation : float [get, set]
  + Shifting : Point3D [get, set]
}
