@startuml
top to bottom direction
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam nodesep 18
skinparam ranksep 24
skinparam packageStyle rectangle
hide empty members
set namespaceSeparator none

title Project-1 — Проект, задача и граничные условия
caption Целевой состав API; расхождения с кодом — ArchitectureDifferences.md
interface "IGeneralData" as T_Project_Project_Interfaces_IGeneralData {
  + Comments : string [get, set]
  + Name : string [get, set]
}
interface "IProject" as T_Project_Project_Interfaces_IProject {
}
interface "IProjectData" as T_Project_Project_Interfaces_IProjectData {
  + GeneralData : IGeneralData [get]
  + Loader : IProjectLoader [get, set]
  + ModelData : IModelData [get, set]
  + Saver : IProjectSaver [get, set]
  + TaskData : ITaskData [get, set]
}
interface "IResult" as T_Project_Project_Interfaces_IResult {
  + Data : DataTable [get]
  + TaskKind : TaskKind [get]
  + Time : float [get]
  + AddData(dbDataTable) : void
  + GetValue(objNumber, resDescr) : float
}
interface "IResultData" as T_Project_Project_Interfaces_IResultData {
  + Loader : IResultsLoader [get, set]
  + Saver : IResultsSaver [get, set]
  + AddRange(results) : void
  + AddRange(results, comparer) : void
  + FindByTaskKind(taskKind) : IEnumerable<Result>
  + FindByTaskKind(taskKind) : IEnumerable<Result>
  + FindByTime(taskKind, time) : IEnumerable<Result>
  + FindByTime(taskKind, time, delta) : IEnumerable<Result>
  + FindByTime(taskKind, time) : IEnumerable<Result>
  + FindByTime(taskKind, time, delta) : IEnumerable<Result>
  + FindByTimeInterval(taskKind, firstTime, lastTime) : IEnumerable<Result>
  + GetResultKinds() : List<TaskKind>
  + Load(path) : void
}
interface "ICillindricalFunction" as T_Project_Project_Interfaces_Tasks_ICillindricalFunction {
  + BottomDiam : float [get]
  + Length : float [get]
  + UpperDiam : float [get]
}
interface "IFrameFunction\nProject-4" as T_Project_Project_Interfaces_Tasks_IFrameFunction <<reference>> [[Project-4.mdpuml Project-4]]
