@startuml
start
:инициализировать пустой словарь;
while (для всех элементов)
	:объявить пустой список points;
	while (для всех граней элемента)
		while (для каждой стороны грани элемента)
			if (есть пересечение стороны и плоскости?) then (да)
				:вычислить точку пересечения стороны и плоскости;
				if (список уже содержит такую точку?) then (нет)
					:добавить точку в список points;
				endif
			endif
		endwhile
	endwhile
	if (число точек не меньше 3 и не больше 6?) then (да)
		:surface = поверхность, состоящая из точек points;
		:добавить номер элемента и surface в словарь;
	endif
endwhile
:вернуть словарь;
stop
@enduml