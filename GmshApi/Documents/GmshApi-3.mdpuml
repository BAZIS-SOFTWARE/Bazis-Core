hide empty members
set namespaceSeparator none

title GmshApi-3 — Жизненный цикл и CAD API
caption Целевой состав API; расхождения с кодом — ArchitectureDifferences.md
class "Gmsh" as T_GmshApi_GmshApi_Gmsh {
  + Logger : Logger [get, private set]
  + Model : Model [get, private set]
  + Option : Option [get, private set]
  + Plugin : Plugin [get, private set]
  + Clear() : void
  + Gmsh()
  + Initialize(argc, argv, readConfigFiles, run) : void
  + IsInitialized() : int
  + Merge(fileName) : void
  + Open(fileName) : void
  + Write(fileName) : void
  + finalize() : void
}
class "GmshKernel" as T_GmshApi_GmshApi_GmshKernel <<static>> {
  + DLL : IntPtr [get, set]
  + GetFunction<T>(functionName) : T
  + GetProcAddress(hModule, procedureName) : IntPtr
  + LoadLibrary(dllToLoad) : IntPtr
}
enum "InvisibleOptions" as T_GmshApi_GmshApi_InvisibleOptions {
    DeleteElements
    ReverseElements
    XMax
    XMin
    YMax
    YMin
    ZMax
    ZMin
}
class "Logger" as T_GmshApi_GmshApi_Logger {
  + Get() : string[]
  + GetLastError() : string
  + Start() : void
  + Stop() : void
  + Write(message, level) : void
}
enum "LoggerLevel" as T_GmshApi_GmshApi_LoggerLevel {
    error
    info
    warning
}
class "Memory" as T_GmshApi_GmshApi_Memory <<internal, static>> {
  + Free(p) : void
  + GetArrayOfObjectsData<T>(outArray, outArrayLength, inArray) : T[][]
  + GetArrayOfString(array, length) : string[]
  + GetObjectsData<T>(src, eCount) : T[]
  + GetString(ptr) : string
  + Malloc(n) : IntPtr
}
