<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0</TargetFrameworks>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <SignAssembly>True</SignAssembly>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Version>3.0.3.7</Version>
    <Company>BAZIS SOFTWARE</Company>
    <Product>BAZIS</Product>
    <Description>Contains basic mesh oblects and geometry classes</Description>
    <Copyright>Bilenko Georgy</Copyright>
    <Authors>Bilenko Georgy, Kapkaev Victor, Kochuk Nicolay</Authors>
    <PackageIcon></PackageIcon>
    <PackageLicenseExpression> MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
    <AssemblyOriginatorKeyFile>GmshApiKey.snk</AssemblyOriginatorKeyFile>
    <Title>GmshApi</Title>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="GmshController\**" />
    <EmbeddedResource Remove="GmshController\**" />
    <None Remove="GmshController\**" />
  </ItemGroup>
  <ItemGroup>
    <None Include="GmshApiKey.snk" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ModelControllerInterfaces\ModelControllerInterfaces.csproj" />
    <ProjectReference Include="..\Model\Model.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="Icon.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>
</Project>