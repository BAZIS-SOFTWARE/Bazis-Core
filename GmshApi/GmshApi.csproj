<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <SignAssembly>True</SignAssembly>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Version>2.0.2.70</Version>
    <Company>BAZIS SOFTWARE</Company>
    <Product>BAZIS</Product>
    <Description>Contains basic mesh oblects and geometry classes</Description>
    <Copyright>Bilenko Georgy</Copyright>
    <Authors>Bilenko Georgy, Kapkaev Victor, Kochuk Nicolay</Authors>
    <PackageIcon>Icon.png</PackageIcon>
    <PackageLicenseExpression> MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
    <AssemblyOriginatorKeyFile>GmshApiKey.snk</AssemblyOriginatorKeyFile>
    <Title>GmshApi</Title>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="System.Data.DataSetExtensions" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Data" />
    <Reference Include="System.Xml" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="GmshController.cs" />
    <Compile Include="GmshKernel.cs" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Icon.png" />
  </ItemGroup>
  <ItemGroup>
    <None Include="GmshApiKey.snk" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Functions" Version="1.0.2.43" />
    <PackageReference Include="Geometry" Version="2.0.7.20" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Model\Model.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="Icon.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>
</Project>