<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Version>2.7.0</Version>
    <Authors>Bilenko Georgy, Ustinov Nikita</Authors>
    <Company>BazisSoftware</Company>
    <Product>BAZIS</Product>
    <Copyright>Bilenko Georgy</Copyright>
    <PackageIcon>Icon.png</PackageIcon>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <Description>Preparation of calculation parameters and TCF command files</Description>
    <SignAssembly>True</SignAssembly>
    <AssemblyOriginatorKeyFile>TaskKey.snk</AssemblyOriginatorKeyFile>
    <PackageOutputPath Condition="'$(OS)' == 'Windows_NT'">c:\BazisComponents\IntPackages_v2\$(Configuration)</PackageOutputPath>
  </PropertyGroup>

	<ItemGroup>
    <Compile Remove="Interfaces\IGeneralParameters.cs" />
    <Compile Remove="Interfaces\ISolverSettings.cs" />
    <Compile Remove="Interfaces\ITimeSettings.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Project\Project.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Icon.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
