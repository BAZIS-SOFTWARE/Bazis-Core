@startuml

start

:нажатие на кнопку "Подтвердить";

while (перебор слоев, \nпока не закончаться)
  while (перебор элементов в слое, \nпока не закончаться)
   if (элемент материнской модели?) then
   #MediumSeaGreen :Запись в группу слоя модели;
   kill
   endif
  #MediumSeaGreen:Запись в группу слоя поддержек;
endwhile
  #MediumAquamarine:Запись в bpf;
    note right
"Материал : имя_слоя_мод мат_мод tn tf *"
"Материал : имя_слоя_под мат_под tn tf *"
"Нагрев : имя_фун/значение имя_слоя_мод tn tf *"
"Нагрев : имя_фун/значение имя_слоя_под tn tf *"
end note
endwhile

:загрузка сформированного bpf файла;
stop

@enduml