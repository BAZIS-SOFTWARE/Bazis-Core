<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;</TargetFrameworks>
    <AssemblyName>Geometry</AssemblyName>
    <RootNamespace>Geometry</RootNamespace>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <SignAssembly>True</SignAssembly>
    <AssemblyOriginatorKeyFile>GeometryKey.snk</AssemblyOriginatorKeyFile>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Version>2.2.51</Version>
    <Authors>Bilenko Georgy, Kapkaev Victor, Khaybrakhmanov Radik, Ustinov Nikita</Authors>
    <Company>BAZIS SOFTWARE</Company>
    <Product>BAZIS</Product>
    <Copyright>Bilenko Georgy</Copyright>
    <PackageIcon>Icon.png</PackageIcon>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
    
    <!--Сохраняет пакет в указанной папке после сборки в зависимости от платформы-->
    <PackageOutputPath>c:\BazisComponents\IntPackages_v2\$(Configuration)</PackageOutputPath>
  </PropertyGroup>
   
  <ItemGroup>
    <EmbeddedResource Include="Icon.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <None Include="GeometryKey.snk" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MathNet.Numerics.Signed" Version="5.0.0" />
  </ItemGroup>
</Project>
