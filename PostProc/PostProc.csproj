<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0</TargetFrameworks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <SignAssembly>True</SignAssembly>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Title>Results</Title>
    <Version>2.2.8</Version>
    <Authors>Bilenko Georgy, Kirill Kishun</Authors>
    <Company>BAZIS SOFTWARE</Company>
    <Product>BAZIS</Product>
    <Description>Gradient fields creator</Description>
    <Copyright>Bilenko Georgy</Copyright>
    <PackageIcon>Icon.png</PackageIcon>
    <PackageTags>Gradients</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
    <AssemblyName>PostProc</AssemblyName>
    <RootNamespace>PostProc</RootNamespace>
    <AssemblyOriginatorKeyFile>ResultsKey.snk</AssemblyOriginatorKeyFile>
    <Platforms>AnyCPU;x64</Platforms>
    <PackageOutputPath Condition="'$(OS)' == 'Windows_NT'">c:\BazisComponents\IntPackages_v2\$(Configuration)</PackageOutputPath>
  </PropertyGroup>
  
  <ItemGroup>
    <EmbeddedResource Remove="ExportTypes\**" />
    <EmbeddedResource Remove="ResultsData\**" />
    <None Remove="ExportTypes\**" />
    <None Remove="ResultsData\**" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="IO\GridExport\GridExporter.cs" />
    <Compile Include="IO\GridExport\IGridSurfacesSaver.cs" />
    <Compile Include="IO\GridExport\IGridExporter.cs" />
	<Compile Include="IO\GridExport\SaveGridSurfacesToBPF.cs" />
    <Compile Include="IO\GridExport\SaveGridSurfacesToBinSTL.cs" />
    <Compile Include="IO\GridExport\SaveGridSurfacesToSTLBase.cs" />
    <Compile Include="IO\GridExport\SaveGridSurfacesToTxtSTL.cs" />
    <Compile Include="IO\ResultExport\IResultsExporter.cs" />
    <Compile Include="IO\ResultExport\IResultsExportSaver.cs" />
    <Compile Include="IO\ResultExport\SaveObjectsResultsToCSV.cs" />
    <Compile Include="IO\ResultExport\SaveObjectsResultsToTXT.cs" />
    <Compile Include="IO\ResultExport\ResultsExporter.cs" />
    <Compile Include="MergeResults.cs" />
    <Compile Include="PostProcController.cs" />
    <Compile Include="ItemRange.cs" />
    <Compile Include="ScenePresenter\ResultFigure.cs" />
    <Compile Include="ScenePresenter\ResultItem.cs" />
    <Compile Include="ScenePresenter\ResultsFieldsCreator.cs" />
    <Compile Include="ScenePresenter\Interfaces\IGradientsCreator.cs" />
    <Compile Include="ScenePresenter\LineGradientsCreator.cs" />
    <Compile Include="ScenePresenter\ResultPoint.cs" />
    <Compile Include="ScenePresenter\ResultSurface.cs" />
    <Compile Include="ScenePresenter\SwapValues.cs" />
    <Compile Include="ScenePresenter\SurfaceGradientsCreator.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Icon.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CsvHelper" Version="33.1.0" />
    <PackageReference Include="System.Data.SQLite" Version="1.0.118" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Model\Model.csproj" />
    <ProjectReference Include="..\ResultDataBase\ResultDB.csproj" />
  </ItemGroup>

</Project>
