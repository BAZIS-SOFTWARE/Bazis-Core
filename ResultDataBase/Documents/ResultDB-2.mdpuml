title ResultDB-2 — Чтение и сохранение
caption Целевой состав API; расхождения с кодом — ArchitectureDifferences.md
interface "IResultsLoader" as T_ResultDB_ResultDB_Interfaces_IResultsLoader {
  + GetResult(fullPath, tables, time) : Result
  + GetResults(fullPath, tables) : IEnumerable<Result>
  + GetTablesNames(fullPath) : IEnumerable<string>
  + GetTablesSchemes(fullPath) : IEnumerable<KeyValuePair<string, List<string>>>
  + GetValues(fullPath, tableName, column) : IEnumerable<float>
}
interface "IResultsSaver" as T_ResultDB_ResultDB_Interfaces_IResultsSaver {
  + Save(results, path, append) : void
}
class "CSVToDataTableConverter" as T_ResultDB_ResultDB_IO_CSVToDataTableConverter {
  + ConvertCSVtoDataTable(strFilePath) : DataTable
}
class "LoadEventArgs" as T_ResultDB_ResultDB_IO_LoadEventArgs {
  + Message : string [get]
  + LoadEventArgs(message)
}
class "LoadResultsFileDB" as T_ResultDB_ResultDB_IO_LoadResultsFileDB {
  + Merge(dbPath1, dbPath2) : string
}
class "SaveEventArgs" as T_ResultDB_ResultDB_IO_SaveEventArgs {
  + Message : string [get, private set]
  + SaveEventArgs(message)
}
