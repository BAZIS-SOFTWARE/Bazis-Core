@startuml
top to bottom direction
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam nodesep 18
skinparam ranksep 24
skinparam packageStyle rectangle
hide empty members
set namespaceSeparator none

allowmixing
title ResultDB — обзор классов и расположение подробностей
caption Обзор; полный состав членов — на нумерованных поддиаграммах
class "Result" as T_ResultDB_ResultDB_Result <<details>>
note right of T_ResultDB_ResultDB_Result
  ResultDB-1
end note
class "ResultDataBase" as T_ResultDB_ResultDB_ResultDataBase <<details>>
note right of T_ResultDB_ResultDB_ResultDataBase
  ResultDB-1
end note
interface "IResultsLoader" as T_ResultDB_ResultDB_Interfaces_IResultsLoader <<details>>
note right of T_ResultDB_ResultDB_Interfaces_IResultsLoader
  ResultDB-2
end note
class "LoadResultsFileDB" as T_ResultDB_ResultDB_IO_LoadResultsFileDB <<details>>
note right of T_ResultDB_ResultDB_IO_LoadResultsFileDB
  ResultDB-2
end note
interface "IResultsSaver" as T_ResultDB_ResultDB_Interfaces_IResultsSaver <<details>>
note right of T_ResultDB_ResultDB_Interfaces_IResultsSaver
  ResultDB-2
end note
class "SaveResultsFileDb" as T_ResultDB_ResultDB_IO_SaveResultsFileDb <<details>>
note right of T_ResultDB_ResultDB_IO_SaveResultsFileDb
  ResultDB-3
end note
T_ResultDB_ResultDB_IO_LoadResultsFileDB ..|> T_ResultDB_ResultDB_Interfaces_IResultsLoader
T_ResultDB_ResultDB_IO_SaveResultsFileDb ..|> T_ResultDB_ResultDB_Interfaces_IResultsSaver
rectangle "Результаты и хранилище" as Area_1 <<область>>
note right of Area_1
  ResultDB-1.mdpuml
end note
rectangle "Чтение и сохранение" as Area_2 <<область>>
note right of Area_2
  ResultDB-2.mdpuml, ResultDB-3.mdpuml
end note
T_ResultDB_ResultDB_Result -[hidden]down-> T_ResultDB_ResultDB_ResultDataBase
T_ResultDB_ResultDB_ResultDataBase -[hidden]down-> T_ResultDB_ResultDB_Interfaces_IResultsLoader
T_ResultDB_ResultDB_Interfaces_IResultsLoader -[hidden]down-> T_ResultDB_ResultDB_IO_LoadResultsFileDB
T_ResultDB_ResultDB_IO_LoadResultsFileDB -[hidden]down-> T_ResultDB_ResultDB_Interfaces_IResultsSaver
T_ResultDB_ResultDB_Interfaces_IResultsSaver -[hidden]down-> T_ResultDB_ResultDB_IO_SaveResultsFileDb
T_ResultDB_ResultDB_IO_SaveResultsFileDb -[hidden]down-> Area_1
Area_1 -[hidden]down-> Area_2
@enduml
