<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0</TargetFrameworks>
    <Title>OperationalController</Title>
    <Version>4.5.2</Version>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <SignAssembly>True</SignAssembly>
    <AssemblyOriginatorKeyFile>ControllerKey.snk</AssemblyOriginatorKeyFile>
    <Company>BAZIS SOFTWARE</Company>
    <Product>BAZIS</Product>
    <Description>Contains basic mesh oblects and geometry classes</Description>
    <Copyright>Bilenko Georgy</Copyright>
    <Authors>Bilenko Georgy, Kapkaev Victor, Kochuk Nicolay, Kishun Kirill, Aleksey Konteev,Máté Cserép</Authors>
    <PackageIcon>Icon.png</PackageIcon>
    <PackageLicenseExpression> MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <PackageOutputPath>c:\BazisComponents\IntPackages_v2\$(Configuration)</PackageOutputPath>
  </PropertyGroup>

  <!--Копирование собранного пакета в необходимую папку-->
  <!--<Target Name="CopyPackage" AfterTargets="Pack">
 <Copy SourceFiles="$(PackageOutputPath)\$(PackageId).$(PackageVersion).nupkg" DestinationFolder="\\fs\Plm-Ural\OrgUnits\developers\Packages\Core\$(Configuration)" />
 </Target>-->

  <ItemGroup>
    <Compile Remove="MeshObjsCreator\Delone2D\**" />
    <EmbeddedResource Remove="MeshObjsCreator\Delone2D\**" />
    <None Remove="MeshObjsCreator\Delone2D\**" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="SceneBrightnessController\ApplyDim.cs" />
    <Compile Remove="SceneBrightnessController\ApplyExample.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Icon.png" />
    <None Remove="Interfaces\Icon.png" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Icon.png">
      <PackagePath>\</PackagePath>
      <Pack>True</Pack>
    </EmbeddedResource>
    <EmbeddedResource Include="Interfaces\Icon.png">
      <PackagePath>\</PackagePath>
      <Pack>True</Pack>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NetOctree" Version="2.1.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GmshApi\GmshApi.csproj" />
    <ProjectReference Include="..\Project\Project.csproj" />
  </ItemGroup>

</Project>
