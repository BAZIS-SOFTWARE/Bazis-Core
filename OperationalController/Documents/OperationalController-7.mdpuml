@startuml
top to bottom direction
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam nodesep 18
skinparam ranksep 24
skinparam packageStyle rectangle
hide empty members
set namespaceSeparator none

title OperationalController-7 — Представление и сообщения об изменениях
caption Целевой состав API; расхождения с кодом — ArchitectureDifferences.md
class "ViewChange" as T_OperationalController_OperationalController_ViewChange {
  + AffectedSets : IEnumerable<ISetInfo> [get]
  + ChangeKind : ModelViewChange [get]
  + GetChangeKind(setInfo) : ModelViewChange
  + ViewChange(changes)
}
enum "ViewMode" as T_OperationalController_OperationalController_ViewMode {
    Line
    LineSurface
    Point
    Surface
}
abstract class "ChangeMessage" as T_OperationalController_OperationalController_ChangeMessage <<reference>>
T_OperationalController_OperationalController_ViewChange -[hidden]down-> T_OperationalController_OperationalController_ViewMode
T_OperationalController_OperationalController_ViewMode -[hidden]down-> T_OperationalController_OperationalController_ChangeMessage
T_OperationalController_OperationalController_ViewChange --|> T_OperationalController_OperationalController_ChangeMessage
legend bottom
  reference — тип раскрыт на другой диаграмме.
  Параметры методов: имена; полные сигнатуры — в соседнем .md.
  Унаследованные члены интерфейсов в классах не повторяются.
endlegend
@enduml
