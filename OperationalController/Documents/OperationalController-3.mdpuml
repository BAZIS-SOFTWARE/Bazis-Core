  - AddCollectionObjects<T>(collection, name, items) : void
  - AddSetObjects<T>(set, items) : bool
  - AddCollectionSets<T>(collection, sets) : IReadOnlyCollection<ISetInfo>
  - RemoveDeadObjects<T>(set) : bool
  - RemoveDeadObjects<T>(collection) : IReadOnlyCollection<ISetInfo>
  - RemoveGeometryEntry<T>(set, number) : bool
  - Replace(data, path, kind, isOpen) : void
