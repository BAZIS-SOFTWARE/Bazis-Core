  + ToEnum<T>(value) : T
}
interface "IProjectController" as T_OperationalController_OperationalController_IProjectController <<reference>>
T_OperationalController_OperationalController_ProjectController -[hidden]down-> T_OperationalController_OperationalController_IProjectController
