  + DeleteModelSet(objType, name) : void
  + Extrude3DForm2D(vector, layers, elements) : void
  + ExtrudeElement1DAlongCurve(curveTags, startPointTag, startNodeTag, step) : string
  + ExtrudeElement3DAlongCurve(surfaceTag, curveTags, startPointTag, step, transfinite) : string
