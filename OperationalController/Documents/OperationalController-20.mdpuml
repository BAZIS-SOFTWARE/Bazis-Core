@startuml
top to bottom direction
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam nodesep 18
skinparam ranksep 24
skinparam packageStyle rectangle
hide empty members
set namespaceSeparator none

title OperationalController-20 — Специализированные контракты контроллера
caption Целевой состав API; расхождения с кодом — ArchitectureDifferences.md
interface "IMeshCommands\nчасть 1/2" as T_OperationalController_OperationalController_IMeshCommands {
  + ChangeMeshSetName(elemDim, oldName, newName) : void
  + ChangeMeshSetOrder(elemDim, name, order) : void
  + ClearEmptySet() : void
  + ClearGeometryMesh() : void
  + ClearGeometryMesh(dimension) : void
  + ClearModelCollection(objType) : void
  + ClearNotExistedModelData() : void
  + ConnectByBeams(masterGroup, slaveGroup, radius, maxBeams) : void
  + Create1DFrom2D() : bool
  + Create2DForm3D() : bool
  + CreateBoundaryEdges(linesNodes) : IEnumerable<ILineObject<Node>>
  + CreateElement(setName, dim, nodeNumbers) : void
  + CreateElementsSet(setName, dim) : void
  + CreateNode(number: int, x: double, y: double, z: double) : void
