@startuml

title Разделение модели и представления: ICoordinated / IModelView

' Обоснование решений, сценарии Gerbera, порядок операций
' и отклонённые варианты - в ModelView.md рядом с этим файлом.
' В тексте заметок не должно быть угловых скобок, кроме <b>:
' просмотрщик принимает их за неизвестный тег и не открывает файл.

' ======================= сборка Geometry =======================
package "Geometry (PrGeometry)" #F7F0FF {

    interface ICoordinated
    {
        +int NumberOfPoints;
        --
        +IEnumerable<Point3D> GetCoordinates();
    }
}

' ======================= сборка Model =======================
package "Model (расчёт, файлы)" #F5F5F5 {

    interface IModelData
    {
        +IObjectsData ObjectData;
        +IGroupData GroupData;
        +VolumeData VolumeData;
        --
        +Append(...);
        +Save(...);
        +Load(...);
    }

    interface IObjectsData

    interface IModelObject
    {
        +int Dim;
        +int Number;
        +ObjType ObjType;
        +bool ExistState;
        --
        +Point3D CalcCentr();
        +SetNumber(int);
    }

    interface ISetInfo
    {
        +string Name;
        +int Number;
        +ObjType ObjType;
        +int NumberOfObjects;
        --
        +IEnumerable<int> GetNumbers();
        +Point3D GetCentr(int);
        +IEnumerable<Point3D> GetCoords(int);
    }

    interface ISurface<T>
    {
        +int Number;
        +bool IsInner;
        --
        +IEnumerable<T> GetVertexes();
    }

    class ElementSurface
    {
        -IElement owner;
        -IElement neighbour;
        --
        +int Number;
        +int ElementNumber;
        +bool IsInner;
        --
        +IEnumerable<IElement> GetElements();
        +int[] CreateNodesKey();
        +SetNeighbour(IElement);
    }

    class Node
    {
        -List<IElement> elements;
        --
        +AddElement(IElement);
        +RemoveElement(IElement);
        +IEnumerable<IElement> GetElements();
    }

    class MarkSurfaces
    {
        +IReadOnlyList<ElementSurface> Mark(IEnumerable<ISurfaceElement>);
    }

    abstract class ModelObject
    class ObjectsSet<T>
    class VolumeFigure
}

' ======================= сборка OperationalController =======================
package "OperationalController (представление)" #EEF5FF {

    interface IModelView
    {
        +IModelData Model;
        +Color SelectionColor;
        +byte Transparency;
        +bool HideInsideSurfaces;
        .. цвет ..
        +Color GetColor(ObjType, int);
        +Color GetColor(ISetInfo, int);
        .. наборы: цвет и режим ..
        +Color GetSetColor(ISetInfo);
        +SetSetColor(ISetInfo, Color);
        +ViewMode GetViewMode(ISetInfo);
        +SetViewMode(ISetInfo, ViewMode);
        .. видимость ..
        +bool GetVisible(ObjType, int);
        +SetVisible(ObjType, IEnumerable<int>, bool);
        +HideSelected();
        +ShowAll();
        .. выделение: чтение ..
        +bool IsSelected(ObjType, int);
        +IEnumerable<int> GetSelected(ObjType);
        +IEnumerable<IModelObject> GetSelection();
        +IEnumerable<ObjType> SelectedTypes;
        +int SelectedCount;
        +bool TryGetSingleSelectedType(out ObjType);
        .. выделение: изменение ..
        +Select(ObjType, IEnumerable<int>);
        +Deselect(ObjType, IEnumerable<int>);
        +ToggleSelection(ObjType, IEnumerable<int>);
        +SetSelection(ObjType, IEnumerable<int>);
        +ClearSelection(ObjType);
        +ClearSelection();
        .. синхронизация с моделью ..
        +Reset();
        +Prune();
        .. пакет и уведомления ..
        +IDisposable BeginUpdate();
        +event Changed;
    }

    class ModelView
    {
        -IModelData model;
        -Dictionary<ObjType, IObjectsView> views;
        --
        +ModelView(IModelData model);
        -IObjectsView GetOrCreateView(ObjType);
        -IObjectsView CreateView();
        -Raise(bool changed);
    }

    interface IObjectsView
    {
        +bool IsEmpty;
        +int SelectedCount;
        +int HiddenCount;
        .. чтение ..
        +bool IsSelected(int);
        +bool IsHidden(int);
        +IEnumerable<int> GetSelected();
        .. выделение ..
        +bool Select(IEnumerable<int>);
        +bool Deselect(IEnumerable<int>);
        +bool ToggleSelection(IEnumerable<int>);
        +bool SetSelection(IEnumerable<int>);
        +bool ClearSelection();
        .. видимость ..
        +bool SetHidden(IEnumerable<int>, bool);
        +bool ShowAll();
        .. наборы этого типа ..
        +Color GetSetColor(ISetInfo);
        +bool SetSetColor(ISetInfo, Color);
        +ViewMode GetViewMode(ISetInfo);
        +bool SetViewMode(ISetInfo, ViewMode);
        +bool ClearSelectionAndHidden();
        .. синхронизация с моделью ..
        +bool Prune(Predicate<int> exists);
        +bool PruneSetStyles(IEnumerable<ISetInfo>);
    }

    class ObjectsView
    {
        -HashSet<int> hidden;
        -HashSet<int> selected;
        -Dictionary<ISetInfo, SetStyle> setStyles;
    }

    class SetStyle
    {
        +Color Color;
        +ViewMode ViewMode;
    }

    class ProjectController
    {
        +IModelView ModelView;
        .. сборка сцены ..
        +IEnumerable<IObjsPresenter> CreateModelPresenters(ObjType);
        +IObjsPresenter CreateSetPresenter(ISetInfo);
    }

    package "ModelScenePresentator" #E4EEFF {

        interface IObjsPresenter
        {
            +string Name;
            +ViewMode ViewMode;
            +PresenterType PresenterType;
            --
            +CreateIndexes();
            +int[] CreatePointers(int);
            +float[] CreateVertexes(int, string);
            +bool[] CreateEdgeFlags(int);
            +int Count();
        }

        interface ISurfaceObjsPresenter

        class PointObjsPresenter
        {
            -IReadOnlyList<IModelObject> objects;
            -IReadOnlyList<Color> colors;
            --
            +PointObjsPresenter(objects, IReadOnlyList<Color>);
            +PointObjsPresenter(objects, Color);
        }

        class LineObjsPresenter<T>

        class SurfaceObjsPresenter<T,U>
        {
            -IReadOnlyList<Color> colors;
            -bool drawInnerSurfaces;
            --
            +SurfaceObjsPresenter(objects, colors, bool);
            -IEnumerable<T> GetDrawnSurfaces(int);
        }

        interface IPresentersCreator
        class PresentersCreator

        interface IPointObjsVertexCreator
        {
            +Create(ref stride, float[] buffer, obj, Color color);
        }
        interface ILineObjsVertexCreator
        interface ISurfaceObjsVertexCreator
    }
}

' ======================= сборка PostProc =======================
package "PostProc (результаты)" #FFF7E8 {
    class ResultFigure
    class ResultSurface
    class ItemRange
}

' ======================= клиент =======================
package "Gerbera (клиент)" #F3FFF3 {
    class SceneWindow
    class PickHandler
}

' ---------- геометрический супертип ----------
ICoordinated <|-- IModelObject
ICoordinated <|-- ISurface
ICoordinated <|.. ResultFigure
ICoordinated <|.. ResultSurface

IModelObject <|.. ModelObject
IModelObject <|.. VolumeFigure

IModelData --> IObjectsData

ISurface <|.. ElementSurface
MarkSurfaces ..> ElementSurface : связывает\nсовпадающие грани
ElementSurface .. Node : одинаковое\nустройство хозяев

' ---------- реализация вида ----------
IModelView <|.. ModelView

IObjectsView <|.. ObjectsView
ObjectsView *-- SetStyle : один на набор
ModelView *-- IObjectsView : один на ObjType
ModelView ..> IObjectsData : Find, GetSetInfo,\nGetSetsInfo

ProjectController ..> IModelView : GetVisible, GetColor;\nGetSelection, Prune, Reset
ProjectController ..> IObjectsData : Remove\nпо номеру

' ---------- сборка буферов ----------
IObjsPresenter <|-- ISurfaceObjsPresenter
IObjsPresenter <|.. PointObjsPresenter
IObjsPresenter <|.. LineObjsPresenter
ISurfaceObjsPresenter <|.. SurfaceObjsPresenter
IPresentersCreator <|.. PresentersCreator

PresentersCreator ..> IObjsPresenter : создаёт по объектам\nи цветам
ProjectController ..> PresentersCreator : два списка\nна набор
ProjectController ..> MarkSurfaces : Mark после\nдобавления элементов
SurfaceObjsPresenter ..> ISurface : IsInner при\nобходе граней

IObjsPresenter --> ICoordinated : обходит объекты
PointObjsPresenter --> IPointObjsVertexCreator : передаёт\nготовый цвет
LineObjsPresenter --> ILineObjsVertexCreator
SurfaceObjsPresenter --> ISurfaceObjsVertexCreator

ItemRange ..> IObjsPresenter : цвет градиентных\nфигур PostProc

' ---------- клиент ----------
SceneWindow *-- ModelView : один экземпляр\nна окно
PickHandler ..> IModelView : GetVisible,\nкоманда
SceneWindow ..> ProjectController : операции

' ======================= заметки =======================

note bottom of ICoordinated
  Чистая геометрия.
  Живёт в Geometry.
  PostProc от Model
  это не освобождает,
  см. ModelView.md.
end note

note bottom of ModelObject
  Наследники получают ICoordinated даром:
  Node, Beam, Element2D, Element3D,
  ElementSurface, GeometryPoint, Curve,
  SurfaceFigure, GeometrySurface.

  ResultFigure и ResultSurface больше
  НЕ IModelObject: это объекты сцены,
  цвет задаёт шкала ItemRange.
end note

note right of ModelView
  Один словарь views вместо
  hidden и selected.

  Любое новое состояние вида -
  поле внутри ObjectsView.
  Стили наборов тоже: набор
  принадлежит одному ObjType,
  ключ - сам ISetInfo по ссылке,
  поэтому переименование его
  не теряет.

  ProjectController отдаёт
  ModelView как null, пока модель
  не загружена; презентеры null
  не принимают.

  Reset не чистит словарь: это
  обход видов с
  ClearSelectionAndHidden,
  стили остаются.
end note

note bottom of PointObjsPresenter
  <b>Презентер о виде не знает вообще</b>
  На входе два списка: объекты и цвета,
  по позициям. Длины сверяются в конструкторе.
  Только видимые - фильтрация снаружи,
  поэтому проверок видимости внутри нет.

  Второй конструктор берёт один Color -
  для нормалей и предпросмотра, где массив
  одинаковых цветов не нужен.

  Line и Surface устроены так же.
end note

note bottom of PresentersCreator
  <b>Кто собирает цвета</b>
  Набор модели - ProjectController:
  GetVisible отсеивает, GetColor(ISetInfo, int)
  красит.
  Результаты - Gerbera по шкале ItemRange,
  PostProc про презентеры не знает.
  Нормали, предпросмотр - один Color на месте.

  Вида в сигнатурах создателя нет, поэтому
  перегрузки "с видом" и "без вида" исчезают,
  а с ними и CoordinatedSurfaceObjsPresenter.
end note

note right of ProjectController
  <b>Цикл отбора живёт только здесь</b>
  CreateSetPresenter - единственное место,
  где объекты набора делятся на видимые
  и скрытые, а видимым подбираются цвета.
  Правило цвета остаётся в ModelView:
  контроллер его спрашивает, не считает.

  Один метод, а не код места вызова:
  забытый GetVisible отрисовал бы скрытое
  молча, а защищать некому - презентер
  видимости не знает.

  Диспетчер по ObjType переезжает сюда же
  из Gerbera, иначе "одно место" станет
  тремя. RefreshModelSetBuffer тогда
  только раздаёт презентеры в VBO.
end note

note bottom of MarkSurfaces
  <b>Внутренние грани: топология, не вид</b>
  Грань с двумя хозяевами не видна никогда.
  Это факт о сетке, как связность, поэтому
  он живёт в Model, а не в ModelView -
  в отличие от удалённого ViewState, который
  был решением пользователя.

  <b>Хранится хозяин, а не признак</b>
  IsInner ничего не хранит и считается на ходу:
  сосед есть и он жив. Устаревать нечему.
  Устройство то же, что у Node с его элементами,
  но грань знает своего владельца с рождения,
  поэтому нового поля нужно одно - сосед.

  Ссылка, а не номер: переживает перенумерацию,
  а проверка ExistState соседа сама обнажает
  грани при удалении элементов, без разлинковки.
  Поэтому Mark нужен только после ДОБАВЛЕНИЯ.

  Связывание - один проход. Ключ строит сама
  грань: CreateNodesKey отдаёт отсортированные
  номера её узлов. Не кэшируется - SetNumber
  узла делал бы его молча неверным, а нужен он
  только внутри Mark.

  Компаратор ключа свой:
  ElementSurfaceEqualityComparer непригоден,
  у ElementSurface не переопределён GetHashCode.
  Грань, встреченная больше двух раз, - дефект
  сетки, о ней Mark сообщает.
end note

note bottom of ObjectsView
  Состояние вида объектов ОДНОГО типа.

  Команды - операции над множеством:
  Select - объединение,
  Deselect - вычитание,
  ToggleSelection - разность,
  SetSelection - замена.

  bool у каждой = "изменилось":
  по нему ModelView поднимает
  Changed и проверяет IsEmpty.
  IsEmpty учитывает и стили наборов.

  Prune берёт предикат и идёт по
  всем типам: ObjectsData.Remove
  каскадный, удаление точки уносит
  кривые с поверхностями.
end note

note left of IObjectsView
  <b>Два правила для вызывающего</b>
  Многотиповая операция - это цикл по типам
  внутри BeginUpdate, отдельного носителя
  набора нет.

  1. Замена начинается с ClearSelection.
     SetSelection(type, ids) заменяет выделение
     целиком, поэтому в цикле каждый вызов
     стирал бы предыдущий: сначала
     ClearSelection, потом Select по типам.
  2. Перед изменением - материализовать.
     GetSelection, GetSelected и SelectedTypes
     ленивы; удаление во время обхода рвёт
     перечисление. Снимок делает вызывающий,
     одним ToList.
end note

note bottom of IObjsPresenter
  Сборка идёт по наборам, а не по объектам:
  GetSetsInfo, на набор один цвет из стиля,
  дальше по номерам GetVisible и GetColor.

  Разрешать набор по номеру нельзя -
  ObjectsData.GetSetInfo перебирает наборы
  линейно и аллоцирует LINQ на каждый вызов.
end note

note left of IModelView
  <b>Ключ - (ObjType, Number)</b>
  Номера не уникальны между типами.
  Режим "Объект" - понятие Gerbera, в ObjType
  его нет: PickHandler отдаёт фактический тип
  попадания, в вид приходит только он.

  <b>GetColor</b>
  выделен -> SelectionColor,
  иначе цвет набора, затем Transparency.
end note

@enduml
