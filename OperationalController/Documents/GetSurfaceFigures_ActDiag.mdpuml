@startuml
:Открыть модель(путь до файла);
#green :Вызов через API презентации STL;
floating note right: Генерация треугольников для геометрических поверхностей step\igs
group GetSurfaceFigures()
:Получить узлы для всех геометрических поверхностей;
:Отсортировать узлы по номеру;
:Создать список SurfaceFigure;
if(Число узлов > 0?) then (да)
    :Получить все идентификаторы поверхностей;
    while (Рассмотрены все поверхности?) is (нет)
        #green :Создать SurfaceFigure;
        floating note right: Для текущего идентификатора поверхности и по набору точек
            :Добавить в список SurfaceFigure;
        backward :Следующая поверхность;
    endwhile(да)
endif
:Возврат списка SurfaceFigure;
end group
stop
@enduml