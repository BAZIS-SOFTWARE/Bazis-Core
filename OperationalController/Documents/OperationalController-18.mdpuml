@startuml
top to bottom direction
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam nodesep 18
skinparam ranksep 24
skinparam packageStyle rectangle
hide empty members
set namespaceSeparator none

title OperationalController-18 — Создание объектов, операции и презентаторы
caption Целевой состав API; расхождения с кодом — ArchitectureDifferences.md
class "BrigthnessController" as T_OperationalController_OperationalController_SceneBrightnessController_BrigthnessController <<internal>> {
  + ApplyBrightness(color, dimFactor, desaturateFactor) : Color
}
legend bottom
  reference — тип раскрыт на другой диаграмме.
  Параметры методов: имена; полные сигнатуры — в соседнем .md.
  Унаследованные члены интерфейсов в классах не повторяются.
endlegend
@enduml
