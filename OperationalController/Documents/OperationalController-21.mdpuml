  + RenumberElements() : void
  + RotateMesh(objType, axis, angle) : void
  + SetCurveMeshingSettings(curveNumber, settings) : void
  + SetMeshAlgorithm2D(algorithm) : void
  + SetMeshAlgorithm3D(algorithm) : void
  + SetMeshMaximumSize(size) : void
  + SetMeshMinimumSize(size) : void
  + SetMeshPointSize(pointNumber, size) : void
  + SetMeshSizeFactor(factor) : void
  + SetSurfaceMeshingSettings(surfaceNumber, settings) : void
  + SetVolumeMeshingSettings(volumeNumber, settings) : void
}
