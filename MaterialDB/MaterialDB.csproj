<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Version>1.2.0</Version>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <!-- PropertyItem, FunctionItem и IProperty устарели, но остаются хранилищем данных до MaterialDB 2.0.0 -->
    <NoWarn>$(NoWarn);CS0618</NoWarn>
    <SignAssembly>True</SignAssembly>
    <PackageOutputPath Condition="'$(OS)' == 'Windows_NT'">c:\BazisComponents\IntPackages_v2\$(Configuration)</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="MaterialData\Parameter.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

</Project>
