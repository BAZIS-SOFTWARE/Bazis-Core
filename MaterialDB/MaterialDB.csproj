  </Target>

  <ItemGroup>
    <Compile Remove="MaterialData\Parameter.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

</Project>
