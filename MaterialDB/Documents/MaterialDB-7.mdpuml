  + ToString() : string
}
class "InterpolationSearch" as T_MaterialDB_MaterialDB_Utilities_InterpolationSearch <<static>> {
  + InterpolatedValue(xAr, yAr, xn) : float
  + InterpolatedValueTwoPoints(x1, x2, y1, y2, xn) : float
}
T_MaterialDB_MaterialDB_MaterialData_MetallurgicalData_ProcessData -[hidden]down-> T_MaterialDB_MaterialDB_Utilities_InterpolationSearch
legend bottom
  reference — тип раскрыт на другой диаграмме.
