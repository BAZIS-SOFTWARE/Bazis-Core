@startuml
top to bottom direction
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam nodesep 18
skinparam ranksep 24
skinparam packageStyle rectangle
hide empty members
set namespaceSeparator none

title MaterialDB-4 — Контракты и данные материалов
caption Целевой состав API; расхождения с кодом — ArchitectureDifferences.md
class "MaterialDBItem" as T_MaterialDB_MaterialDB_MaterialData_MaterialDBItem {
  + CategoryData : CategoryData [get, set]
  + CategoryDic : Dictionary<CategoryEnum, string> [field]
  + Name : string [get, set]
  + this[CategoryEnum key] : Category [get, set]
  + this[string key] : Category [get, set]
  + AddCrystallization(ts, tl) : void
  + AddGeneralProps() : void
  + AddHardeningModel(mode) : void
  + AddMaterialModel(mode) : void
  + AddMechProps() : void
  + AddMetallurgicalProps() : void
  + AddPhaseData(phases) : void
  + AddThermalProps() : void
  + CheckMechanicalProps() : bool
  + CheckPhaseData() : bool
  + CheckThermalProps() : bool
  + Copy(copyName) : MaterialDBItem
  + GetHashCode() : int
  + GetPhases() : IEnumerable<string>
  ~ MaterialDBItem()
  + MaterialDBItem(name)
}
legend bottom
  reference — тип раскрыт на другой диаграмме.
  Параметры методов: имена; полные сигнатуры — в соседнем .md.
  Унаследованные члены интерфейсов в классах не повторяются.
endlegend
@enduml
