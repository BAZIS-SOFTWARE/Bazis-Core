@startuml
top to bottom direction
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam nodesep 18
skinparam ranksep 24
skinparam packageStyle rectangle
hide empty members
set namespaceSeparator none
title MaterialDB-11 — Настройки создания материалов
caption Состав свойств материала задаётся в конструкторе через объекты настроек
class "MaterialSettings" as T_MaterialDB_MaterialDB_MaterialData_Settings_MaterialSettings {
  + MaterialModel : MaterialModel [get, set]
}
class "SolidMaterialSettings" as T_MaterialDB_MaterialDB_MaterialData_Settings_SolidMaterialSettings {
  + HardeningModel : int [get, set]
  + HardnessIndices : HardnessPhaseIndices? [get, set]
  + HardnessModel : int [get, set]
  + LiquidusTemperature : double [get, set]
  + Phases : PhaseData [get, set]
  + SolidusTemperature : double [get, set]
}
class "FluidMaterialSettings" as T_MaterialDB_MaterialDB_MaterialData_Settings_FluidMaterialSettings {
  + ReferencePressure : double [get, set]
}
class "GasMaterialSettings" as T_MaterialDB_MaterialDB_MaterialData_Settings_GasMaterialSettings {
  + DensityModel : DensityModel [get, set]
  + MolarMass : double? [get, set]
  + Sutherland : SutherlandCoefficients? [get, set]
  + ViscosityModel : ViscosityModel [get, set]
}
class "SutherlandCoefficients" as T_MaterialDB_MaterialDB_MaterialData_Settings_SutherlandCoefficients <<sealed>> {
  + Mu0 : double [get]
  + S : double [get]
  + T0 : double [get]
  + SutherlandCoefficients(mu0, t0, s)
}
class "MaterialDBItem" as T_MaterialDB_MaterialDB_MaterialData_MaterialDBItem <<reference>>
note left of T_MaterialDB_MaterialDB_MaterialData_MaterialDBItem
  [[MaterialDB-4.mdpuml MaterialDB-4]]
end note
class "SolidMaterialItem" as T_MaterialDB_MaterialDB_MaterialData_SolidMaterialItem <<reference>>
class "LiquidMaterialItem" as T_MaterialDB_MaterialDB_MaterialData_LiquidMaterialItem <<reference>>
class "GasMaterialItem" as T_MaterialDB_MaterialDB_MaterialData_GasMaterialItem <<reference>>
note bottom of T_MaterialDB_MaterialDB_MaterialData_LiquidMaterialItem
  [[MaterialDB-8.mdpuml MaterialDB-8]]
end note
class "PhaseData" as T_MaterialDB_MaterialDB_MaterialData_MetallurgicalData_PhaseData <<reference>>
note right of T_MaterialDB_MaterialDB_MaterialData_MetallurgicalData_PhaseData
  [[MaterialDB-6.mdpuml MaterialDB-6]]
end note
class "HardnessPhaseIndices" as T_MaterialDB_MaterialDB_MaterialData_HardnessPhaseIndices <<reference>>
note right of T_MaterialDB_MaterialDB_MaterialData_HardnessPhaseIndices
  [[MaterialDB-9.mdpuml MaterialDB-9]]
end note
T_MaterialDB_MaterialDB_MaterialData_Settings_MaterialSettings <|-- T_MaterialDB_MaterialDB_MaterialData_Settings_SolidMaterialSettings
T_MaterialDB_MaterialDB_MaterialData_Settings_MaterialSettings <|-- T_MaterialDB_MaterialDB_MaterialData_Settings_FluidMaterialSettings
T_MaterialDB_MaterialDB_MaterialData_Settings_FluidMaterialSettings <|-- T_MaterialDB_MaterialDB_MaterialData_Settings_GasMaterialSettings
T_MaterialDB_MaterialDB_MaterialData_Settings_GasMaterialSettings --> T_MaterialDB_MaterialDB_MaterialData_Settings_SutherlandCoefficients : Sutherland
T_MaterialDB_MaterialDB_MaterialData_Settings_SolidMaterialSettings --> T_MaterialDB_MaterialDB_MaterialData_MetallurgicalData_PhaseData : Phases
T_MaterialDB_MaterialDB_MaterialData_Settings_SolidMaterialSettings --> T_MaterialDB_MaterialDB_MaterialData_HardnessPhaseIndices : HardnessIndices
T_MaterialDB_MaterialDB_MaterialData_MaterialDBItem ..> T_MaterialDB_MaterialDB_MaterialData_Settings_MaterialSettings : конструктор
T_MaterialDB_MaterialDB_MaterialData_SolidMaterialItem ..> T_MaterialDB_MaterialDB_MaterialData_Settings_SolidMaterialSettings : конструктор
T_MaterialDB_MaterialDB_MaterialData_LiquidMaterialItem ..> T_MaterialDB_MaterialDB_MaterialData_Settings_FluidMaterialSettings : конструктор
T_MaterialDB_MaterialDB_MaterialData_GasMaterialItem ..> T_MaterialDB_MaterialDB_MaterialData_Settings_GasMaterialSettings : конструктор
legend bottom
  Обзор: [[MaterialDB.mdpuml MaterialDB]]. Перечисления MaterialModel, DensityModel, ViscosityModel — [[MaterialDB-9.mdpuml MaterialDB-9]].
  Пространство имён: MaterialDB.MaterialData.Settings. Классы содержат только данные.
  По умолчанию: Isotropic, давление 1 МПа, модели плотности и вязкости Table;
  твёрдое тело — фаза «phase» (доля 1), TS 1400, TL 1500, упрочнение 2, твердость 0 (выключена).
  MolarMass — строка «M» в «Модели плотности», SutherlandCoefficients — строки μ0, T0, S в «Модели вязкости»;
  при табличной модели они не сохраняются.
  IdealGas требует MolarMass, Sutherland — коэффициенты; твёрдому телу нужны фазы, TS < TL,
  индексы при HardnessModel = 1. Иначе конструктор бросает ArgumentException.
  reference — тип раскрыт на другой диаграмме.
endlegend
@enduml
