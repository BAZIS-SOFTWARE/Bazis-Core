@startuml
top to bottom direction
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam nodesep 18
skinparam ranksep 24
skinparam packageStyle rectangle
hide empty members
set namespaceSeparator none

allowmixing
title MaterialDB — обзор классов и расположение подробностей
caption Состояние MaterialDB 1.2.0; полный состав членов — на нумерованных поддиаграммах
interface "IMaterialDB" as T_MaterialDB_MaterialDB_Interfaces_IMaterialDB <<details>>
note right of T_MaterialDB_MaterialDB_Interfaces_IMaterialDB
  MaterialDB-1
end note
class "MaterialDBData" as T_MaterialDB_MaterialDB_MaterialData_MaterialDBData <<details>>
note right of T_MaterialDB_MaterialDB_MaterialData_MaterialDBData
  MaterialDB-3
end note
class "MaterialDBItem (abstract)" as T_MaterialDB_MaterialDB_MaterialData_MaterialDBItem <<details>>
note right of T_MaterialDB_MaterialDB_MaterialData_MaterialDBItem
  MaterialDB-4
end note
class "SolidMaterialItem" as T_MaterialDB_MaterialDB_MaterialData_SolidMaterialItem <<details>>
class "LiquidMaterialItem" as T_MaterialDB_MaterialDB_MaterialData_LiquidMaterialItem <<details>>
class "GasMaterialItem" as T_MaterialDB_MaterialDB_MaterialData_GasMaterialItem <<details>>
note right of T_MaterialDB_MaterialDB_MaterialData_GasMaterialItem
  MaterialDB-8
end note
class "MaterialSettings" as T_MaterialDB_MaterialDB_MaterialData_Settings_MaterialSettings <<details>>
note right of T_MaterialDB_MaterialDB_MaterialData_Settings_MaterialSettings
  MaterialDB-11
end note
class "MaterialDBItemConverter" as T_MaterialDB_MaterialDB_MaterialData_MaterialDBItemConverter <<details>>
note right of T_MaterialDB_MaterialDB_MaterialData_MaterialDBItemConverter
  MaterialDB-8
end note
interface "ICategory" as T_MaterialDB_MaterialDB_Interfaces_ICategory <<details>>
note right of T_MaterialDB_MaterialDB_Interfaces_ICategory
  MaterialDB-1
end note
class "Category" as T_MaterialDB_MaterialDB_MaterialData_Category <<details>>
note right of T_MaterialDB_MaterialDB_MaterialData_Category
  MaterialDB-3
end note
interface "IProperty" as T_MaterialDB_MaterialDB_Interfaces_IProperty <<details>>
note right of T_MaterialDB_MaterialDB_Interfaces_IProperty
  MaterialDB-1
end note
class "DataItem" as T_MaterialDB_DataItem <<details>>
note right of T_MaterialDB_DataItem
  MaterialDB-5
end note
class "PropertyItem" as T_MaterialDB_MaterialDB_MaterialData_PropertyItem <<details>>
note right of T_MaterialDB_MaterialDB_MaterialData_PropertyItem
  MaterialDB-5
end note
class "FunctionDBData" as T_MaterialDB_MaterialDB_FunctionData_FunctionDBData <<details>>
note right of T_MaterialDB_MaterialDB_FunctionData_FunctionDBData
