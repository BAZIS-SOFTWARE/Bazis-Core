@startuml
top to bottom direction
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam nodesep 18
skinparam ranksep 24
skinparam packageStyle rectangle
skinparam class {
  BackgroundColor<<new>> #E3F4E1
  BackgroundColor<<changed>> #FFF4D6
  BackgroundColor<<obsolete>> #F2F2F2
  BackgroundColor<<external>> #E6EEF8
}
hide empty members
set namespaceSeparator none

title MaterialDB-Target-3 — материал и категории
caption Целевое состояние; спецификация — MaterialDB-Spec.md, разделы 4.6, 5.2, 5.3, 6.2
class "MaterialDBItem" as T_MaterialDB_MaterialDB_MaterialData_MaterialDBItem <<changed>> <<abstract>> {
  + CategoryDic : Dictionary<CategoryEnum, string> [field] [changed: + Fluid, Gas]
  + CategoryData : CategoryData [get, set]
  + Name : string [get, set]
  + this[CategoryEnum key] : Category [get, set]
  + this[string key] : Category [get, set]
  .. среда ..
  + {abstract} Medium : MediumKind [get, new]
  + HasMetallurgy : bool [get, new]
  .. создание и свойства ..
  # MaterialDBItem(name, settings) [new: «Общие сведения» + «Модель материала»]
  + CheckProps() : bool [virtual] [new: тепловые; ρ не нужна при IdealGas]
  # AddProps() : void [virtual] [new: тепловые; раскладка по HasMetallurgy]
  # AddGeneralProps() : void [changed: protected; метка среды у Liquid/Gas]
  # AddMaterialModel(model) : void [changed: protected; MaterialModel]
  + GetPhases() : IEnumerable<string> [changed: пусто без металлургии]
  + Copy(copyName) : MaterialDBItem [changed: сохраняет класс]
}
class "SolidMaterialItem" as T_MaterialDB_MaterialDB_MaterialData_SolidMaterialItem <<new>> {
  + SolidMaterialItem(name)
  + SolidMaterialItem(name, settings)
  + CheckProps() : bool [override: + механические]
  # AddProps() : void [override: + механические]
  + AddMetallurgicalProps() : void
  + AddCrystallization(ts, tl) : void
  + AddHardeningModel(mode) : void
  + AddHardnessModel(mode, indices) : void
  + CheckPhaseData() : bool
}
class "LiquidMaterialItem" as T_MaterialDB_MaterialDB_MaterialData_LiquidMaterialItem <<new>> {
  + LiquidMaterialItem(name)
  + LiquidMaterialItem(name, settings)
  + CheckProps() : bool [override: + вязкость Fluid]
  # AddProps() : void [override: + вязкость Fluid]
}
class "GasMaterialItem" as T_MaterialDB_MaterialDB_MaterialData_GasMaterialItem <<new>> {
  + GasMaterialItem(name)
  + GasMaterialItem(name, settings)
  + CheckProps() : bool [override: + вязкость Gas / Сазерленд]
  # AddProps() : void [override: + вязкость Gas при Table]
}
