  + WriteJson(...) : void
}
class "Category" as T_MaterialDB_MaterialDB_MaterialData_Category <<changed>> {
  + PropertyDic : Dictionary<PropertyEnum, string> [field] [changed: + 19 свойств; Capacity → «Теплоемкость»]
  + this[PropertyEnum key] : DataItem [get, set] [changed: было PropertyItem]
}
note right of T_MaterialDB_MaterialDB_MaterialData_Category
  ICategory — [[MaterialDB-Target-2.mdpuml MaterialDB-Target-2]]
  CategoryData — [[../MaterialDB-3.mdpuml MaterialDB-3]];
  в 1.2.0 исправлен индексатор CategoryData[PropertyEnum]
  (поиск по русскому имени вместо key.ToString()).
end note
