@startuml
top to bottom direction
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam nodesep 18
skinparam ranksep 24
skinparam packageStyle rectangle
skinparam class {
  BackgroundColor<<new>> #E3F4E1
  BackgroundColor<<changed>> #FFF4D6
  BackgroundColor<<obsolete>> #F2F2F2
  BackgroundColor<<external>> #E6EEF8
}
hide empty members
set namespaceSeparator none

title MaterialDB-Target-1 — перечисления и классификация материала
caption Целевое состояние; спецификация — MaterialDB-Spec.md, разделы 3, 4.1–4.3, 5.2
enum "MediumKind" as T_MaterialDB_MaterialDB_MaterialData_MediumKind <<new>> {
    Solid = 0
    Liquid = 1
    Gas = 2
}
enum "DensityModel" as T_MaterialDB_MaterialDB_MaterialData_DensityModel <<new>> {
    Table = 0
    IdealGas = 1
}
enum "ViscosityModel" as T_MaterialDB_MaterialDB_MaterialData_ViscosityModel <<new>> {
    Table = 0
    Sutherland = 1
}
enum "ArgumentKind" as T_MaterialDB_MaterialDB_MaterialData_ArgumentKind <<new>> {
    Undefined = 0 (только маркер отсутствия в JSON)
    Constant = 1
    Argument = 2 (одна переменная X)
    TemperaturePhase = 3
    TemperaturePressure = 4
    Descriptor = 5
    Process = 6
}
enum "CategoryEnum" as T_MaterialDB_MaterialDB_MaterialData_CategoryEnum <<changed>> {
    General
    Thermal
    Mechanical
    Metallurgical
    Fluid [new] «Гидродинамические свойства»
    Gas [new] «Газодинамические свойства»
}
enum "PropertyEnum" as T_MaterialDB_MaterialDB_MaterialData_PropertyEnum <<changed>> {
    … 12 существующих значений без изменений
    MediumKind [new] «Агрегатное состояние»
    DensityModel [new] «Модель плотности»
    MolarMass [obsolete] строка «M» в «Модели плотности»
    ReferencePressure [new] «Опорное давление»
    ViscosityModel [new] «Модель вязкости»
    SutherlandCoefficients [obsolete] строки μ0, T0, S в «Модели вязкости»
    DynamicViscosity [new] «Динамическая вязкость»
    Compressibility [new] «Сжимаемость»
    VolumeExpansion [new] «Коэффициент объёмного расширения»
    ThermalConductivityX/Y/Z [new] «Теплопроводность X/Y/Z»
    YoungModuleX/Y/Z [new] «Модуль Юнга X/Y/Z»
    ThermalExpansionX/Y/Z [new] «ТКЛР X/Y/Z»
    HardnessModel [new] «Модель твердости» (+ индексы фаз Куркина)
}
class "HardnessPhaseIndices" as T_MaterialDB_MaterialDB_MaterialData_HardnessPhaseIndices <<new>> <<sealed>> {
  + HardnessPhaseIndices(ferrite, perlite, beinite, martensite, austenite)
  + FerriteIndex : int [get]
  + PerliteIndex : int [get]
  + BeiniteIndex : int [get]
  + MartensiteIndex : int [get]
  + AusteniteIndex : int [get]
}
class "MaterialDBItem" as T_MaterialDB_MaterialDB_MaterialData_MaterialDBItem <<reference>>
note right of T_MaterialDB_MaterialDB_MaterialData_MaterialDBItem
  [[MaterialDB-Target-3.mdpuml MaterialDB-Target-3]]
  Medium и HasMetallurgy — свойства;
  MaterialDescriptor нет (решение пользователя)
end note
T_MaterialDB_MaterialDB_MaterialData_MaterialDBItem ..> T_MaterialDB_MaterialDB_MaterialData_MediumKind : Medium
T_MaterialDB_MaterialDB_MaterialData_MaterialDBItem ..> T_MaterialDB_MaterialDB_MaterialData_DensityModel : «Модель плотности»
T_MaterialDB_MaterialDB_MaterialData_MaterialDBItem ..> T_MaterialDB_MaterialDB_MaterialData_ViscosityModel : «Модель вязкости»
T_MaterialDB_MaterialDB_MaterialData_MaterialDBItem ..> T_MaterialDB_MaterialDB_MaterialData_HardnessPhaseIndices : «Модель твердости» (индексы)
T_MaterialDB_MaterialDB_MaterialData_ArgumentKind -[hidden]down-> T_MaterialDB_MaterialDB_MaterialData_CategoryEnum
T_MaterialDB_MaterialDB_MaterialData_CategoryEnum -[hidden]right-> T_MaterialDB_MaterialDB_MaterialData_PropertyEnum
legend bottom
  Обзор: [[MaterialDB-Target.mdpuml MaterialDB-Target]].
  ArgumentKind используется в DataItem — [[MaterialDB-Target-2.mdpuml MaterialDB-Target-2]].
  Argument: для свойств материала X — температура, для функций — любая переменная (например, время).
  Металлургия — не флаг, а наличие «Структуры» в «Общих сведениях».
  [new] — новый член изменённого типа; reference — тип раскрыт на другой диаграмме.
endlegend
@enduml
